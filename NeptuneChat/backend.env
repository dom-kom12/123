# NeptuneChat Backend Configuration
# This file contains the actual configuration values
# DO NOT commit this file to version control

# Server Configuration
PORT=3344
HOST=0.0.0.0

# JWT Secret for authentication
JWT_SECRET=your_secure_jwt_secret_here_generate_with_node

# Session Secret for encryption
SESSION_SECRET=your_secure_session_secret_here_generate_with_node

# Database Configuration
DATABASE_PATH=./database.db

# CORS Configuration
CORS_ORIGIN=*

# Discord Webhook URL (optional)
DISCORD_WEBHOOK_URL=

# Web Push VAPID Keys (optional)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=60
