# NeptuneChat Backend Configuration
# Copy this file to backend.env and update the values

# Server Configuration
PORT=3344
HOST=0.0.0.0

# JWT Secret for authentication (generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_this_to_a_secure_random_string

# Session Secret for encryption (generate your own)
SESSION_SECRET=change_this_to_another_secure_random_string

# Database Configuration
DATABASE_PATH=./database.db

# CORS Configuration (comma-separated list of allowed origins, or * for all)
CORS_ORIGIN=*

# Discord Webhook URL (optional, for notifications)
DISCORD_WEBHOOK_URL=

# Web Push VAPID Keys (optional, for browser notifications)
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=60
